{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sda/job-market-intelligence/schemas/job-opportunity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunityId",
    "organizationId",
    "role",
    "sourceEvidence",
    "observedAt"
  ],
  "properties": {
    "opportunityId": {
      "type": "string",
      "minLength": 1
    },
    "organizationId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "employmentType": {
      "type": [
        "string",
        "null"
      ]
    },
    "seniority": {
      "type": [
        "string",
        "null"
      ]
    },
    "compensation": {
      "type": [
        "object",
        "null"
      ]
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "businessProblems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "productAreas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aiThemes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
