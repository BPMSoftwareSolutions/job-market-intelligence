{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-market-intelligence.local/schemas/experience-evidence.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceId",
    "missionId",
    "opportunityId",
    "targetCapability",
    "marketSignalId",
    "marketEvidenceFactIds",
    "demonstratedObligationIds",
    "missingObligationIds",
    "evidenceMaturity",
    "repository",
    "admissionStatus"
  ],
  "properties": {
    "evidenceId": { "type": ["string", "null"] },
    "missionId": { "type": "string", "minLength": 1 },
    "opportunityId": { "type": "string", "minLength": 1 },
    "targetCapability": { "type": "string", "minLength": 1 },
    "marketSignalId": { "type": "string", "minLength": 1 },
    "marketEvidenceFactIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "demonstratedObligationIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "missingObligationIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceMaturity": {
      "enum": ["EXPOSURE", "IMPLEMENTATION", "INTEGRATION", "OPERATION", "PRODUCTION", "MASTERY", null]
    },
    "repository": { "type": ["string", "null"] },
    "admissionStatus": {
      "enum": ["ADMITTED", "REJECTED_INCOMPLETE", "REJECTED_UNPROVEN", "NO_MISSION_TO_ADMIT"]
    }
  }
}
