{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-market-intelligence.local/schemas/experience-acquisition-opportunity.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunityId",
    "targetCapability",
    "marketSignalId",
    "marketEvidenceFactIds",
    "reason"
  ],
  "properties": {
    "opportunityId": { "type": "string", "minLength": 1 },
    "targetCapability": { "type": "string", "minLength": 1 },
    "marketSignalId": { "type": "string", "minLength": 1 },
    "marketEvidenceFactIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reason": { "const": "NO_ADMITTED_EVIDENCE" }
  }
}
