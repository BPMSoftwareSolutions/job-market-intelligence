{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-market-intelligence.local/contracts/public-job-market-observation-state.v1.schema.json",
  "type": "object",
  "required": ["observationId", "organizationIds", "sourceIds", "observedFrom", "observedTo", "maxResultsPerSource"],
  "properties": {
    "observationId": { "type": "string", "minLength": 1 },
    "organizationIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "observedFrom": { "type": "string" },
    "observedTo": { "type": "string" },
    "maxResultsPerSource": { "type": "integer", "minimum": 1 }
  }
}
