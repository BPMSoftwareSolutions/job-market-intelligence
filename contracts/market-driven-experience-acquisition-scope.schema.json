{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-market-intelligence.local/contracts/market-driven-experience-acquisition-scope.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["experienceGapResolutionScope", "selectedTargetCapability", "executionTestimony", "experienceWindow"],
  "properties": {
    "experienceGapResolutionScope": {
      "$ref": "https://job-market-intelligence.local/contracts/experience-gap-resolution-scope.v1.schema.json"
    },
    "selectedTargetCapability": { "type": "string", "minLength": 1 },
    "experienceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "minLength": 1 },
        "end": { "type": "string", "minLength": 1 }
      }
    },
    "executionTestimony": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "demonstratedObligationIds", "proof"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "demonstratedObligationIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tests", "executionClosure"],
          "properties": {
            "tests": { "enum": ["PASS", "FAIL"] },
            "executionClosure": { "enum": ["PASS", "FAIL"] }
          }
        }
      }
    }
  }
}
