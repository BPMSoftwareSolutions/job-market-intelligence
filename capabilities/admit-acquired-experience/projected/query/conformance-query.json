    "outcome-to-transition",
    "transition-to-next-input",
    "scenario-to-interface",
    "execution-to-telemetry",
    "scenario-to-projection",
    "expected-to-observed-execution",
    "root-to-terminal-behavior",
    "required-mechanic-to-platform-capability",
    "consumer-executable-origin",
