  ],
  "dispositionPolicy": "all-required-closures-conform",
  "authorityGraph": {
    "rootScenarioId": "admit-acquired-experience",
    "scenarios": [
      {
        "scenarioId": "admit-acquired-experience",
        "input": {
          "inputId": "experience-admission-scope",
          "contract": {
            "contractId": "experience-admission-scope.v1"
          }
        },
        "event": {
          "eventId": "admit-acquired-experience",
          "executionAuthorityId": "admit-acquired-experience.v1"
        },
        "outcome": {
          "outcomeId": "experience-admission-profile",
          "contract": {
            "contractId": "experience-admission-profile.v1"
          },
          "experience": {
            "statement": "I have new inspectable experience evidence only when every obligation was demonstrated and proven"
          },
          "terminal": true
        },
        "gherkin": {
          "given": {
            "semanticRef": "admit-acquired-experience.given",
            "text": "a projected experience mission and execution testimony for it"
          },
          "when": {
            "semanticRef": "admit-acquired-experience.when",
            "text": "the testimony is checked against every scenario obligation the mission required"
          },
          "then": {
            "semanticRef": "admit-acquired-experience.then",
            "text": "I have new inspectable experience evidence only when every obligation was demonstrated and proven"
          }
        },
        "name": "Admit evidence only for a fully demonstrated, proven mission"
      }
    ],
    "transitions": [],
    "executionAuthorities": [
      {
        "id": "admit-acquired-experience.v1",
        "owningScenarioId": "admit-acquired-experience",
        "operations": [
          {
            "kind": "invoke-port",
            "portId": "admit-experience-evidence"
          }
        ]
      }
    ],
    "projectionAuthorities": [],
    "interfaceAuthority": {
      "interfaceAuthorityType": "consumer-interface-authority.v1",
      "contractValidatorCapabilityId": "sda-schema-contract-admission.v1",
      "contractCatalog": "../../contracts/experience-admission-contract-catalog.json",
      "requiredPlatformObligations": [
        "dynamic-semantic-execution",
        "domain-contract-admission"
      ],
      "interfaces": [
        {
          "interfaceId": "experience-admission-cli",
          "kind": "cli",
          "rootScenarioId": "admit-acquired-experience",
          "platformCapabilityId": "sda-json-cli.v1"
        }
      ],
      "portBindings": [
        {
          "portId": "admit-experience-evidence",
          "platformCapabilityId": "sda-authority-transformation-port.v1",
          "configuration": {
            "expression": {
              "op": "merge",
              "values": [
                {
                  "op": "path",
                  "from": "input"
                },
                {
                  "op": "object",
                  "fields": {
                    "experienceEvidence": {
                      "op": "let",
                      "bindings": {
                        "requiredObligationIds": {
                          "op": "map",
                          "from": {
                            "op": "path",
                            "from": "input",
                            "path": "experienceMission.scenarioObligations"
                          },
                          "as": "obligation",
                          "value": {
                            "op": "path",
                            "from": "obligation",
                            "path": "obligationId"
                          }
                        },
                        "demonstratedObligationIds": {
                          "op": "path",
                          "from": "input",
                          "path": "executionTestimony.demonstratedObligationIds"
                        },
                        "missingObligationIds": {
                          "op": "filter",
                          "from": {
                            "op": "path",
                            "from": "requiredObligationIds"
                          },
                          "as": "obligationId",
                          "where": {
                            "op": "equals",
                            "left": {
                              "op": "includes",
                              "in": {
                                "op": "path",
                                "from": "demonstratedObligationIds"
                              },
                              "value": {
                                "op": "path",
                                "from": "obligationId"
                              }
                            },
                            "right": {
                              "op": "literal",
                              "value": false
                            }
                          }
                        },
                        "hasMission": {
                          "op": "equals",
                          "left": {
                            "op": "path",
                            "from": "input",
                            "path": "experienceMission.missionStatus"
                          },
                          "right": {
                            "op": "literal",
                            "value": "MISSION_PROJECTED"
                          }
                        },
                        "isProven": {
                          "op": "if",
                          "when": {
                            "op": "equals",
                            "left": {
                              "op": "path",
                              "from": "input",
                              "path": "executionTestimony.proof.tests"
                            },
                            "right": {
                              "op": "literal",
                              "value": "PASS"
                            }
                          },
                          "then": {
                            "op": "equals",
                            "left": {
                              "op": "path",
                              "from": "input",
                              "path": "executionTestimony.proof.executionClosure"
                            },
                            "right": {
                              "op": "literal",
                              "value": "PASS"
                            }
                          },
                          "else": {
                            "op": "literal",
                            "value": false
                          }
                        },
                        "isComplete": {
                          "op": "equals",
                          "left": {
                            "op": "length",
                            "value": {
                              "op": "path",
                              "from": "missingObligationIds"
                            }
                          },
                          "right": {
                            "op": "literal",
                            "value": 0
                          }
                        },
                        "admissionStatus": {
                          "op": "if",
                          "when": {
                            "op": "path",
                            "from": "hasMission"
                          },
                          "then": {
                            "op": "if",
                            "when": {
                              "op": "path",
                              "from": "isProven"
                            },
                            "then": {
                              "op": "if",
                              "when": {
                                "op": "path",
                                "from": "isComplete"
                              },
                              "then": {
                                "op": "literal",
                                "value": "ADMITTED"
                              },
                              "else": {
                                "op": "literal",
                                "value": "REJECTED_INCOMPLETE"
                              }
                            },
                            "else": {
                              "op": "literal",
                              "value": "REJECTED_UNPROVEN"
                            }
                          },
                          "else": {
                            "op": "literal",
                            "value": "NO_MISSION_TO_ADMIT"
                          }
                        }
                      },
                      "value": {
                        "op": "object",
                        "fields": {
                          "evidenceId": {
                            "op": "if",
                            "when": {
                              "op": "equals",
                              "left": {
                                "op": "path",
                                "from": "admissionStatus"
                              },
                              "right": {
                                "op": "literal",
                                "value": "ADMITTED"
                              }
                            },
                            "then": {
                              "op": "format",
                              "template": "evidence-{missionId}",
                              "values": {
                                "missionId": {
                                  "op": "path",
                                  "from": "input",
                                  "path": "experienceMission.missionId"
                                }
                              }
                            },
                            "else": {
                              "op": "literal",
                              "value": null
                            }
                          },
                          "missionId": {
                            "op": "path",
                            "from": "input",
                            "path": "experienceMission.missionId"
                          },
                          "opportunityId": {
                            "op": "path",
                            "from": "input",
                            "path": "experienceMission.opportunityId"
                          },
                          "targetCapability": {
                            "op": "path",
                            "from": "input",
                            "path": "experienceMission.targetCapability"
                          },
                          "marketSignalId": {
                            "op": "path",
                            "from": "input",
                            "path": "experienceMission.marketSignalId"
                          },
                          "marketEvidenceFactIds": {
                            "op": "path",
                            "from": "input",
                            "path": "experienceMission.marketEvidenceFactIds"
                          },
                          "demonstratedObligationIds": {
                            "op": "path",
                            "from": "demonstratedObligationIds"
                          },
                          "missingObligationIds": {
                            "op": "path",
                            "from": "missingObligationIds"
                          },
                          "evidenceMaturity": {
                            "op": "if",
                            "when": {
                              "op": "equals",
                              "left": {
                                "op": "path",
                                "from": "admissionStatus"
                              },
                              "right": {
                                "op": "literal",
                                "value": "ADMITTED"
                              }
                            },
                            "then": {
                              "op": "path",
                              "from": "input",
                              "path": "experienceMission.targetEvidenceMaturity"
                            },
                            "else": {
                              "op": "literal",
                              "value": null
                            }
                          },
                          "repository": {
                            "op": "if",
                            "when": {
                              "op": "equals",
                              "left": {
                                "op": "path",
                                "from": "admissionStatus"
                              },
                              "right": {
                                "op": "literal",
                                "value": "ADMITTED"
                              }
                            },
                            "then": {
                              "op": "path",
                              "from": "input",
                              "path": "executionTestimony.repository"
                            },
                            "else": {
                              "op": "literal",
                              "value": null
                            }
                          },
                          "admissionStatus": {
                            "op": "path",
                            "from": "admissionStatus"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "projectionBindings": []
    },
