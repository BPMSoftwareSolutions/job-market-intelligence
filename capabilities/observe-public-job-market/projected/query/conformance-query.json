          "experience": {
            "statement": "I can review the public job openings found within my observation scope"
          }
        },
        "gherkin": {
          "given": {
            "semanticRef": "collect-current-hiring-activity.given",
            "text": "the companies I want to observe"
          },
          "when": {
            "semanticRef": "collect-current-hiring-activity.when",
            "text": "their permitted public job sources are checked and current openings are observed"
          },
          "then": {
            "semanticRef": "collect-current-hiring-activity.then",
            "text": "I can review the public job openings found within my observation scope"
          }
        },
        "name": "Collect current hiring activity for selected companies"
